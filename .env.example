# All variables are OPTIONAL. Corvane Signal runs fully offline without any of them.

# Optional: rewrites the "what to do" narrative on the Monday view. Analysis never depends on it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: traces the narrative LLM calls above.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=corvane-signal
LANGSMITH_TRACING=true

# Optional: persist raw responses + analysis to Supabase (used by the Vercel deployment).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
